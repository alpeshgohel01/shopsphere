# ──────────────────────────────────────────────────────────────
# ShopSphere -- environment variables
# Copy to .env and fill in. Never commit real secrets.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string (Atlas or local). Used by Better Auth AND the shop.
MONGODB_URI=

# ── Better Auth ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32  (min 32 chars)
BETTER_AUTH_SECRET=

# Canonical auth base URL (no trailing slash, no /sign-in path)
# Keep LOCALHOST here for local .env -- do NOT flip this for deploys.
# On Vercel: set Production env to your live URL, e.g. https://shopsphere.vercel.app
# (code also auto-uses VERCEL_PROJECT_PRODUCTION_URL and rejects localhost on Vercel)
BETTER_AUTH_URL=http://localhost:3000

# Same as BETTER_AUTH_URL for local. On Vercel set Production to the live URL.
# Client redirects use window.location.origin so this is mainly for build metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (optional -- leave empty to hide Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional -- leave empty to hide GitHub button)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional providers (enable in src/lib/auth-features.js)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Email ─────────────────────────────────────────────────────
# Resend transactional email. If missing in development, links are logged to the server console.
RESEND_API_KEY=

# From address verified in Resend (or onboarding@resend.dev for testing)
EMAIL_FROM="ShopSphere <onboarding@resend.dev>"

# ── Stripe (payments) -- use TEST keys while developing ────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Local webhook secret: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (prints a whsec_... value). In production use the endpoint's signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Cloudinary (product image uploads) -- optional ─────────────
# Without these, admins can still add product images by Unsplash URL.
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Feature flags / ops ───────────────────────────────────────
# Passwordless magic-link sign-in (set both for client UI + server plugin)
ENABLE_MAGIC_LINK=false
NEXT_PUBLIC_ENABLE_MAGIC_LINK=false

# Expose /api/test/last-email in non-dev (e.g. CI). Never enable in production.
ENABLE_TEST_HOOKS=false

# Rate limiter backend: mongodb | memory
RATE_LIMIT_BACKEND=mongodb
